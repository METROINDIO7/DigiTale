// ==================== EQUIPAMIENTO ====================
@PanelEquipamiento = Group {
    LayoutMode: Left;

    Group {
        LayoutMode: Left;

        Label {
            Text: "EQUIPO ACTUAL";
            Style: (TextColor: #ff00ff, FontSize: 13, RenderBold: true);
            Anchor: (Width: 200);
        }

        Group { FlexWeight: 1; }

        $C.@SecondaryButton #ItemEquipo {
            Anchor: (Width: 200, Height: 50);
            Padding: (Horizontal: 8, Vertical: 8);
            Label {
                Text: "Sin equipo";
                Style: (TextColor: #8899aa, FontSize: 13, VerticalAlignment: Center);
            }
        }
    }

    Group { Anchor: (Height: 8); }

    $C.@ContentSeparator {}

    Group { Anchor: (Height: 8); }

    Group {
        LayoutMode: Left;

        Label {
            Text: "ARMA";
            Style: (TextColor: #00d4ff, FontSize: 13, RenderBold: true);
            Anchor: (Width: 200);
        }

        Group { FlexWeight: 1; }

        $C.@SecondaryButton #ItemArma {
            Anchor: (Width: 200, Height: 50);
            Padding: (Horizontal: 8, Vertical: 8);
            Label {
                Text: "Sin arma";
                Style: (TextColor: #8899aa, FontSize: 13, VerticalAlignment: Center);
            }
        }
    }

    Group { Anchor: (Height: 8); }

    $C.@ContentSeparator {}

    Group { Anchor: (Height: 8); }

    Group {
        LayoutMode: Left;

        Label {
            Text: "ARMADURA";
            Style: (TextColor: #00d4ff, FontSize: 13, RenderBold: true);
            Anchor: (Width: 200);
        }

        Group { FlexWeight: 1; }

        $C.@SecondaryButton #ItemArmadura {
            Anchor: (Width: 200, Height: 50);
            Padding: (Horizontal: 8, Vertical: 8);
            Label {
