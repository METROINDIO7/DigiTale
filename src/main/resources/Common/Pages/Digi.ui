$TextHighlightGradientMask = "Common/SelectedIconGradient.png";

// ==================== CONTENEDORES ====================
@SimpleContainer = Group {
    Background: (TexturePath: "Digi/Digi_Container.png", Border: 20);
};

@DecoratedContainer = Group {
    LayoutMode: Top;
    Background: (TexturePath: "Digi/Digi_ContainerDark.png", Border: 20);
    Padding: (Full: 8);
};

@ContentSeparator = Group {
    Anchor: (Height: 2);
    Background: (Color: #00d4ff);
    Padding: (Horizontal: 8);
};

// ==================== BOTONES ====================
@BackButton = TextButton {
    Anchor: (Left: 16, Bottom: 16, Width: 120, Height: 40);
    Text: "Volver";
    Style: (TextColor: #00d4ff, FontSize: 16);
    Background: (TexturePath: "Digi/Digi_Container.png", Border: 8);
};

@SecondaryButton = Group {
    Background: (TexturePath: "Digi/Digi_Container.png", Border: 8);
};

// ==================== TABS ====================
// ==================== HEADER ====================
@HeaderTabsStyle = TabNavigationStyle(
    TabStyle: (
        Default: (
            Anchor: (Height: 66, Left: 2, Right: 0),
            IconOpacity: 0.4
        ),
        Hovered: (
            IconOpacity: 0.6
        ),
        Pressed: (
            IconOpacity: 0.8
        )
    ),
    SelectedTabStyle: (
        Default: (
            IconOpacity: 1,
            Background: (TexturePath: "Common/HeaderTabSelectedBackground.png", Border: 7),
            ContentMaskTexturePath: "Common/SelectedIconGradient.png"
        )
    )
);

// ==================== PANEL ====================
@Panel = Group {
    LayoutMode: Top;
    Background: (Color: #12121e);
    Padding: (Full: 8);
};

// ==================== INPUT ====================
@DefaultInputFieldStyle = TextFieldStyle(
    Background: (TexturePath: "Digi/Digi_Container.png", Border: 8),
    Padding: (Full: 8)
);

// ==================== TOOLTIP ====================
@DefaultTextTooltipStyle = TooltipStyle(
    Background: (TexturePath: "Digi/Digi_ContainerDark.png", Border: 4),
    Padding: (Full: 8),
    Style: (TextColor: #e0e8f0, FontSize: 14)
);

// ==================== LABELS ====================

@LabelTitle = Label {
    Style: (TextColor: #00d4ff, FontSize: 18, RenderBold: true);
};

@LabelSubtitle = Label {
    Style: (TextColor: #e0e8f0, FontSize: 14);
};

@LabelInfo = Label {
    Style: (TextColor: #8899aa, FontSize: 12);
};

@LabelError = Label {
    Style: (TextColor: #ff00ff, FontSize: 14, RenderBold: true);
};

@LabelSuccess = Label {
    Style: (TextColor: #00ff88, FontSize: 14);
};

@LabelWarning = Label {
    Style: (TextColor: #ffcc00, FontSize: 14);
};

@LabelDanger = Label {
    Style: (TextColor: #ff4444, FontSize: 14);
};

// ==================== PANELS ====================
@PanelEquipo = Group {
    LayoutMode: Left;
    Padding: (Full: 10);
};

@PanelSlot = Group {
    Anchor: (Width: 200, Height: 130);
    Background: (TexturePath: "Digi/Digi_Container.png", Border: 8);
    Padding: (Full: 8);
};

@PanelStats = Group {
    LayoutMode: Left;
    Padding: (Vertical: 4);
};

// ==================== BOTONES ====================
@BtnIntercambiar = TextButton {
    Text: "⇄";
    Anchor: (Width: 50, Height: 30);
    Style: (Default: (Background: (Color: #16213e), LabelStyle: (FontSize: 12, TextColor: #00d4ff, HorizontalAlignment: Center)), Hovered: (Background: (Color: #1a5a90), LabelStyle: (FontSize: 12, TextColor: #ffffff, HorizontalAlignment: Center)));
};

@BtnPerfil = TextButton {
    Text: "Perfil";
    Anchor: (Width: 70, Height: 30);
    Style: (Default: (Background: (Color: #16213e), LabelStyle: (FontSize: 12, TextColor: #e0e8f0, HorizontalAlignment: Center)), Hovered: (Background: (Color: #1a5a90), LabelStyle: (FontSize: 12, TextColor: #ffffff, HorizontalAlignment: Center)));
};

@BtnAccion = TextButton {
    Anchor: (Width: 140, Height: 44);
    Style: (Default: (Background: (Color: #16213e), LabelStyle: (FontSize: 14, TextColor: #e0e8f0, VerticalAlignment: Center)), Hovered: (Background: (Color: #1a5a90), LabelStyle: (FontSize: 14, TextColor: #ffffff, VerticalAlignment: Center)), Pressed: (Background: (Color: #0f3460), LabelStyle: (FontSize: 14, TextColor: #00d4ff, VerticalAlignment: Center)));
};

@BtnAccionPequeño = TextButton {
    Anchor: (Width: 100, Height: 36);
    Style: (Default: (Background: (Color: #16213e), LabelStyle: (FontSize: 12, TextColor: #e0e8f0, HorizontalAlignment: Center)), Hovered: (Background: (Color: #1a5a90), LabelStyle: (FontSize: 12, TextColor: #ffffff, HorizontalAlignment: Center)), Pressed: (Background: (Color: #0f3460), LabelStyle: (FontSize: 12, TextColor: #00d4ff, HorizontalAlignment: Center)));
};

// ==================== PROGRESS BAR ====================
@ProgressBarVida = $C.@ProgressBar #ProgressBar75 {
    @Anchor = (Bottom: 4, Left: 0);
    Value: 0.75;
}

// ==================== ICONOS ====================
@IconDigimon = AssetImage {
    Anchor: (Top: 0, Left: 0, Width: 80, Height: 80);
    AssetPath: "Icons/ModelsGenerated/DigiPlaceholder.png";
};

@IconDigimonGrande = AssetImage {
    Anchor: (Top: 0, Left: 0, Width: 100, Height: 100);
    AssetPath: "Icons/ModelsGenerated/DigiPlaceholder.png";
};

// ==================== ENLACES ====================
@LinkDigimon = Group {
    LayoutMode: Left;
    Anchor: (Top: 50, Left: 8);

    TextButton {
        Text: "⇄";
        Anchor: (Width: 50, Height: 30);
        Style: (Default: (Background: (Color: #16213e), LabelStyle: (FontSize: 12, TextColor: #00d4ff, HorizontalAlignment: Center)), Hovered: (Background: (Color: #1a5a90), LabelStyle: (FontSize: 12, TextColor: #ffffff, HorizontalAlignment: Center)));
    }

    Group { FlexWeight: 1; }

    TextButton {
        Text: "Perfil";
        Anchor: (Width: 70, Height: 30);
        Style: (Default: (Background: (Color: #16213e), LabelStyle: (FontSize: 12, TextColor: #e0e8f0, HorizontalAlignment: Center)), Hovered: (Background: (Color: #1a5a90), LabelStyle: (FontSize: 12, TextColor: #ffffff, HorizontalAlignment: Center)));
    }
};

// ==================== TITULO ====================
@TituloPrincipal = Label {
    Text: "DIGIMON COMPANEROS";
    Style: (TextColor: #00d4ff, FontSize: 18, RenderBold: true);
    Anchor: (Left: 8);
};

@SubtituloPrincipal = Label {
    Text: "NAVEGACION";
    Style: (TextColor: #00d4ff, FontSize: 16, RenderBold: true, HorizontalAlignment: Center);
    Anchor: (Height: 24);
};

