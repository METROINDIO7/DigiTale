            Style: (TextColor: #8899aa, FontSize: 12, VerticalAlignment: Center);
        }
    }
};

@FieldLabel = Label {
    Style: (TextColor: #00d4ff, FontSize: 12);
};

@FieldContainer = Group {
    LayoutMode: Left;
    Background: (Color: #1a1a2e);
    Padding: (Full: 4);
};

@FieldValue = Label {
    Style: (TextColor: #e0e8f0, FontSize: 14);
};

@FieldValueWrap = Label {
    Style: (TextColor: #8899aa, FontSize: 12, Wrap: true);
};

// ==================== DIGIMON HP BAR ====================
@DigiHP = Group {
    LayoutMode: Top;
    Anchor: (Height: 20);
    Background: (Color: #333344);
    Border: (Size: 2, Color: #555566);

    Label #CurrentHP {
        Text: "";
        Style: (TextColor: #00ff88, FontSize: 12);
        Anchor: (Left: 4);
    }

    Group {
        LayoutMode: Left;
        Anchor: (Height: 8);
        Background: (Color: #222233);
        Border: (Size: 1, Color: #444455);

        Group #HPBar {
            LayoutMode: Left;
            Anchor: (Width: 100);
            Background: (Color: #00ff88);
        }
    }
};

// ==================== DIGIMON EXP BAR ====================
@DigiExp = Group {
    LayoutMode: Top;
    Anchor: (Height: 16);
    Background: (Color: #333344);
    Border: (Size: 1, Color: #555566);

    Group #ExpBar {
        LayoutMode: Left;
        Anchor: (Width: 100);
        Background: (Color: #ff00ff);
    }
};
