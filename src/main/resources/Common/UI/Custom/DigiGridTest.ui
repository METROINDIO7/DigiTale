Group {
    LayoutMode: Top;
    Anchor: (Height: 400, Width: 480);

    Group {
        LayoutMode: Top;
        Background: (Color: #0b1220);
        Padding: (Full: 15);

        Label {
            Text: "PRUEBA ARRASTRE (ItemGrid)";
            Style: (TextColor: #ffcc00, FontSize: 16, RenderBold: true, HorizontalAlignment: Center);
            Anchor: (Height: 26);
        }
        Label {
            Text: "Arrastra los iconos entre casillas. Todo queda en el log.";
            Style: (TextColor: #8899aa, FontSize: 11, HorizontalAlignment: Center, Wrap: true);
            Anchor: (Height: 28);
        }
        ItemGrid #GridTest {
            Anchor: (Width: 420, Height: 80);
            SlotsPerRow: 6;
            AreItemsDraggable: true;
            DisplayItemQuantity: true;
        }
        Group { Anchor: (Height: 6); }
        Label #LblTest {
            Text: "Sin eventos aun.";
            Style: (TextColor: #00d4ff, FontSize: 12, HorizontalAlignment: Center, Wrap: true);
            Anchor: (Height: 60);
        }
        TextButton #BtnCerrarTest {
            Text: "Cerrar";
            Anchor: (Width: 200, Height: 32);
            Style: (Default: (Background: (Color: #3c1a1a), LabelStyle: (FontSize: 12, TextColor: #ff8888, HorizontalAlignment: Center)), Hovered: (Background: (Color: #5c2727), LabelStyle: (FontSize: 12, TextColor: #ffffff, HorizontalAlignment: Center)));
        }
    }
}
